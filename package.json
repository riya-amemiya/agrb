{
	"name": "agrb",
	"version": "1.5.1",
	"description": "Interactive CLI to rebase a branch onto another safely (cherry-pick or linear rebase)",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riya-amemiya/agrb.git"
	},
	"homepage": "https://github.com/riya-amemiya/agrb#readme",
	"bugs": {
		"url": "https://github.com/riya-amemiya/agrb/issues"
	},
	"scripts": {
		"build": "tsc --noEmit && vite build",
		"dev": "vite build --watch",
		"test": "oxlint && oxfmt --check",
		"eslint": "eslint src",
		"lint": "oxlint --fix && oxfmt",
		"ci": "oxlint && oxfmt --check",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"git",
		"rebase",
		"cherry-pick",
		"cli",
		"ink",
		"github"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"ag-toolkit": "0.7.1",
		"ink": "8.0.0",
		"ink-select-input": "6.2.0",
		"ink-spinner": "5.0.0",
		"react": "19.3.1",
		"simple-git": "4.0.2",
		"umt": "5.1.1"
	},
	"overrides": {
		"react": "19.3.1",
		"ink": "8.0.0",
		"ink-select-input": "6.2.0",
		"ink-spinner": "5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sindresorhus/tsconfig": "9.0.0",
		"@types/bun": "1.4.4",
		"@types/react": "19.3.0",
		"@typescript-eslint/eslint-plugin": "8.72.1",
		"@typescript-eslint/parser": "8.72.1",
		"chalk": "6.0.1",
		"eslint": "10.14.0",
		"eslint-plugin-unicorn": "79.0.0",
		"ink-testing-library": "4.0.0",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"ts-node": "10.9.2",
		"typescript": "7.0.2",
		"vite": "8.3.6"
	}
}
